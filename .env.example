# ==============================================================================
# EZCOOL — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Supabase: Create a project at https://supabase.com
#    Go to Project Settings -> API to find URL, Anon Key, and Service Role Key.
# 2. Resend: Create an API key at https://resend.com/api-keys
# 3. Save this file as .env.local (do NOT commit .env.local to Git)
# ==============================================================================

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Server-side privileged operations only; keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Resend Email Delivery Configuration (Server-side only; keep secret)
# Note: onboarding@resend.dev is Resend's default test sender (delivers only to your registered Resend account email).
# For full production delivery to any customer, verify your custom domain in Resend and update RESEND_FROM_EMAIL.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=EZCOOL <onboarding@resend.dev>
