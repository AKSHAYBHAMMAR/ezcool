# ==============================================================================
# EZCOOL — Supabase Backend Configuration
# ==============================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon public key below
# 4. Save this file as .env.local (do NOT commit .env.local to Git)
# ==============================================================================

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Server-side privileged operations only; keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

